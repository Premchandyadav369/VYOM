# ==============================================================================
# VERA × DRUNIX Configuration Environment
# Intent-Governed Payment Infrastructure for Digital Payments
# ==============================================================================

# Application Environment
ENV=development
DEBUG=True
APP_NAME="VERA x DRUNIX"
APP_VERSION="1.0.0"
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000

# Security & Cryptography
JWT_SECRET_KEY=vera_super_secure_jwt_secret_key_change_in_production_389274819
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
VERA_SERVICE_SIGNING_KEY=vera_ed25519_service_signing_private_key_demo_secret

# Database Configuration
# Default to SQLite local file, override with PostgreSQL in production/docker:
# DATABASE_URL=postgresql://vera_user:vera_pass@localhost:5432/vera_db
DATABASE_URL=sqlite:///./vera_storage.db

# Redis / KeyDB Transient Store Configuration
# If REDIS_URL is not reachable, VERA will use its built-in in-memory transient store.
REDIS_URL=redis://localhost:6379/0

# DRUNIX Distributed Ledger Configuration
# DRUNIX_MODE: 'SIMULATOR' or 'REAL'
DRUNIX_MODE=SIMULATOR
DRUNIX_PEER_ENDPOINT=localhost:7051
DRUNIX_ORDERER_ENDPOINT=localhost:7050
DRUNIX_VS_ENDPOINT=localhost:7071
DRUNIX_CHANNEL_NAME=payments-channel
DRUNIX_CHAINCODE_NAME=vera-payment-state
DRUNIX_MSP_ID=Org1MSP
DRUNIX_CRYPTO_PATH=./blockchain/network/crypto-config

# Machine Learning & AI Settings
RANDOM_SEED=42
ML_DEVICE=cpu
MODEL_CACHE_DIR=./ml/models/cache
INTENT_MODEL_NAME=all-MiniLM-L6-v2

# Policy Engine Thresholds (Configurable)
POLICY_VERSION=vera-policy-v1
THRESHOLD_ALLOW_MAX_RISK=0.35
THRESHOLD_VERIFY_MAX_RISK=0.70
THRESHOLD_HOLD_MIN_RISK=0.71
MIN_INTENT_CONSISTENCY=0.55
MIN_RECIPIENT_TRUST=0.40

# Observability
LOG_LEVEL=INFO
ENABLE_PROMETHEUS_METRICS=True
METRICS_PORT=9090
